  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "node_modules/.tmp/tsnode"
  },
  "include": ["vite.config.ts", "vite-plugins/**/*.ts", "src/shared/chatCore.ts", "src/shared/modelPolicy.ts", "e2e/**/*.ts", "playwright.config.ts"]
}
