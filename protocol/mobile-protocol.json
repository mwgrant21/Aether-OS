      { "s": "claude", "label": "Terminal" },
      { "s": "terminal2", "label": "Terminal 2" },
      { "s": "codex", "label": "Codex" }
    ],
    "states": ["not-started", "running", "exited"],
    "chunkMaxBytes": 16384,
    "ringBytes": 262144,
    "snapshotBytes": 262144,
    "snapshotScrollbackLines": 1000,
    "mirrorScrollbackLines": 2000,
