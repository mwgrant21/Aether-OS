    "maxCodeFailures": 5,
    "bodyCapBytes": 1024,
    "confirmTimeoutMs": 60000,
    "qrUri": "aethermobile://pair?host=<ip>&port=<port>&code=XXXX-XXXX"
  },
  "token": {
    "bytes": 32,
    "encoding": "base64url",
    "slidingTtlMs": 2592000000,
    "absoluteTtlMs": 15552000000
